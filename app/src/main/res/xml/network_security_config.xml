<?xml version="1.0" encoding="utf-8"?>
<!-- The backend usually runs on a PC in the same Wi-Fi over plain HTTP, so cleartext is allowed.
     Use an https:// backend URL when you deploy it publicly. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
