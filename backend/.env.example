# Copy to .env and fill in. Never commit .env.

# Which LLM to use: gemini (default, free tier) | anthropic | mock (offline keyword rules, no key)
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_KEY_HERE
# Free-tier models with function calling. Flash-Lite is fastest for voice; if a model is
# overloaded (503) or rate limited (429) the backend tries the fallbacks in order.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Voice replies (Gemini text-to-speech). The free tier allows ~3 requests/minute per model,
# so several models are tried in turn; the phone falls back to its own voice when all are busy.
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
# Voices: Despina (smooth), Achernar (soft), Leda (youthful), Vindemiatrix (gentle), and more.
GEMINI_TTS_VOICE=Despina

# Optional: Anthropic Claude (paid). https://platform.claude.com/
ANTHROPIC_API_KEY=PASTE_KEY_HERE
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high (leave empty to use the model default)
CLAUDE_EFFORT=low

# Shared secret the app sends in the X-Jarvis-Secret header. Use a long random string,
# and paste the same value into the app's Settings > Shared secret.
APP_SHARED_SECRET=PASTE_SECRET_HERE

PORT=8787
HOST=0.0.0.0
RATE_LIMIT_PER_MINUTE=30
